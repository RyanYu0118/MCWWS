# 生存模式 Axiom 建造：开放全部 axiom.* 权限，按格扣费由 MCWWS_AxiomSurvival 处理

function mcwwsGrantAxiomSurvivalPerms():
    if plugin "LuckPerms" is not enabled:
        stop
    set {_g} to "default"
    execute console command "lp group %{_g}% permission set axiom.* true"
    execute console command "lp group %{_g}% permission unset axiom.player.gamemode.creative"
    execute console command "lp group %{_g}% permission unset axiom.player.gamemode.spectator"
    execute console command "lp group %{_g}% permission set mcwws.axiom.survival.use true"
    log "[MCWWS] 已为 default 组开放 axiom.* 全部权限（生存扣费仍由 MCWWS_AxiomSurvival 处理）"

on Skript start:
    wait 6 seconds
    mcwwsGrantAxiomSurvivalPerms()

on script load:
    wait 2 seconds
    mcwwsGrantAxiomSurvivalPerms()
