# BetterBags：任何时候都不发放/保留背包头颅，也不自动入包
# - 插件侧已切断 giveBagToPlayer / auto-picking；本脚本为热重载兜底
# - 打开背包请走菜单左键 /bags open，不要发 PLAYER_HEAD

import:
    org.bukkit.NamespacedKey
    org.bukkit.persistence.PersistentDataType
    org.bukkit.event.player.PlayerAttemptPickupItemEvent
    org.bukkit.event.block.BlockPlaceEvent
    org.bukkit.event.inventory.InventoryClickEvent
    org.bukkit.event.inventory.InventoryDragEvent
    org.bukkit.event.player.PlayerDropItemEvent

function mcwwsIsBetterBagItem(it: object) :: boolean:
    if {_it} is not set:
        return false
    if {_it} is air:
        return false
    set {_key} to new NamespacedKey("betterbags", "item")
    set {_tag} to {_it}.getItemMeta().getPersistentDataContainer().get({_key}, PersistentDataType.STRING)
    if {_tag} is "bag":
        return true
    return false

function mcwwsStripInventoryBagItems(inv: object, size: number) :: boolean:
    set {_removed} to false
    if {_inv} is not set:
        return false
    loop {_size} times:
        set {_slot} to loop-number - 1
        set {_it} to {_inv}.getItem({_slot})
        if mcwwsIsBetterBagItem({_it}) is true:
            {_inv}.setItem({_slot}, null)
            set {_removed} to true
    return {_removed}

function mcwwsRemoveBetterBagSkullInternal(p: player, silent: boolean):
    set {_removed} to mcwwsStripInventoryBagItems({_p}.getInventory(), 41)
    if mcwwsStripInventoryBagItems({_p}.getEnderChest(), 27) is true:
        set {_removed} to true
    if mcwwsIsBetterBagItem({_p}.getItemOnCursor()) is true:
        {_p}.setItemOnCursor(null)
        set {_removed} to true
    if {_silent} is true:
        stop
    if {_removed} is true:
        send "§6[背包] §f已收回背包头颅。" to {_p}
    else:
        send "§6[背包] §7物品栏里没有背包头颅。" to {_p}

function mcwwsRemoveBetterBagSkull(p: player):
    mcwwsRemoveBetterBagSkullInternal({_p}, false)

function mcwwsRemoveBetterBagSkullSilent(p: player):
    mcwwsRemoveBetterBagSkullInternal({_p}, true)

command /mcwws-bags-reclaim:
    description: 收回 BetterBags 背包头颅（物品栏 / 末影箱 / 光标）
    trigger:
        delete {mcwws.bags.allowed::%uuid of player%}
        mcwwsRemoveBetterBagSkull(player)

on join:
    wait 2 ticks
    mcwwsRemoveBetterBagSkullSilent(player)

every 5 seconds:
    loop all players:
        mcwwsRemoveBetterBagSkullSilent(loop-player)

on command:
    if command is "bags":
        if arg-1 is "give":
            wait 1 tick
            loop all players:
                mcwwsRemoveBetterBagSkullSilent(loop-player)

on PlayerAttemptPickupItemEvent with priority lowest:
    set {_itemEnt} to event.getItem()
    set {_item} to {_itemEnt}.getItemStack()
    if mcwwsIsBetterBagItem({_item}) is true:
        event.setCancelled(true)
        {_item}.setAmount(0)
        {_itemEnt}.setItemStack({_item})
        {_itemEnt}.remove()
        mcwwsRemoveBetterBagSkullSilent(event.getPlayer())

on BlockPlaceEvent:
    if mcwwsIsBetterBagItem(event.getItemInHand()) is true:
        event.setCancelled(true)
        mcwwsRemoveBetterBagSkullSilent(event.getPlayer())

on InventoryClickEvent with priority monitor:
    if event.getWhoClicked() is a player:
        set {_p} to event.getWhoClicked()
        mcwwsRemoveBetterBagSkullSilent({_p})

on InventoryDragEvent with priority monitor:
    if event.getWhoClicked() is a player:
        set {_p} to event.getWhoClicked()
        mcwwsRemoveBetterBagSkullSilent({_p})

on PlayerDropItemEvent:
    set {_drop} to event.getItemDrop().getItemStack()
    if mcwwsIsBetterBagItem({_drop}) is true:
        event.setCancelled(true)
        mcwwsRemoveBetterBagSkullSilent(event.getPlayer())
