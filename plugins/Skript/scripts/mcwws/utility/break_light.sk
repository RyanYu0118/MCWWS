# MCWWS：生存/冒险左键拆除光源并掉落；站立右键调节亮度（同创造）
# 手持光源时：用 ItemDisplay 显示中间 2D 图标（非粒子），贴近原版状态提示

import:
    org.bukkit.Bukkit
    org.bukkit.Material
    org.bukkit.util.BlockIterator
    org.bukkit.util.Transformation
    org.bukkit.event.block.BlockBreakEvent
    org.bukkit.inventory.ItemStack
    org.bukkit.entity.ItemDisplay
    org.bukkit.entity.Display
    org.joml.Vector3f
    org.joml.Quaternionf
    java.util.UUID

function mcwwsIsLightRayPassable(type: object) :: boolean:
    if {_type} is Material.AIR:
        return true
    if {_type} is Material.CAVE_AIR:
        return true
    if {_type} is Material.VOID_AIR:
        return true
    if {_type} is Material.LIGHT:
        return true
    if {_type} is Material.WATER:
        return true
    if {_type} is Material.BUBBLE_COLUMN:
        return true
    return false

function mcwwsFindLookedLight(p: player, range: number) :: object:
    set {_iter} to new BlockIterator({_p}, {_range})
    while {_iter}.hasNext():
        set {_block} to {_iter}.next()
        set {_type} to {_block}.getType()
        if {_type} is Material.LIGHT:
            return {_block}
        if mcwwsIsLightRayPassable({_type}) is false:
            return null
    return null

function mcwwsBreakLightAsPlayer(p: player, block: object) :: boolean:
    set {_event} to new BlockBreakEvent({_block}, {_p})
    Bukkit.getPluginManager().callEvent({_event})
    if {_event}.isCancelled() is true:
        return false
    set {_loc} to {_block}.getLocation().add(0.5, 0.5, 0.5)
    set {_world} to {_block}.getWorld()
    {_block}.setType(Material.AIR)
    {_world}.dropItemNaturally({_loc}, new ItemStack(Material.LIGHT, 1))
    play sound "block.stone.break" with volume 1 and pitch 0.8 at {_loc} for {_p}
    return true

function mcwwsLightItemForLevel(level: number) :: object:
    set {_item} to new ItemStack(Material.LIGHT, 1)
    set {_meta} to {_item}.getItemMeta()
    set {_bd} to Material.LIGHT.createBlockData()
    {_bd}.setLevel({_level})
    {_meta}.setBlockData({_bd})
    {_item}.setItemMeta({_meta})
    return {_item}

function mcwwsGetLightLevel(block: object) :: number:
    return {_block}.getBlockData().getLevel()

function mcwwsCycleLightLevel(p: player, block: object) :: boolean:
    set {_data} to {_block}.getBlockData()
    set {_level} to {_data}.getLevel() + 1
    if {_level} > 15:
        set {_level} to 0
    {_data}.setLevel({_level})
    {_block}.setBlockData({_data})
    set {_loc} to {_block}.getLocation().add(0.5, 0.5, 0.5)
    play sound "ui.button.click" with volume 0.4 and pitch 1.2 at {_loc} for {_p}
    # 同步该玩家看到的 ItemDisplay 图标亮度贴图
    set {_puuid} to "%uuid of {_p}%"
    set {_key} to mcwwsLightBlockKey({_block})
    set {_uuidText} to {mcwws.lightIcon::%{_puuid}%::%{_key}%}
    if {_uuidText} is set:
        set {_id} to UUID.fromString({_uuidText})
        set {_ent} to Bukkit.getEntity({_id})
        if {_ent} is set:
            if "%{_ent}%" is not "null":
                {_ent}.setItemStack(mcwwsLightItemForLevel({_level}))
    return true

function mcwwsLightBlockKey(block: object) :: text:
    set {_loc} to {_block}.getLocation()
    set {_w} to {_loc}.getWorld().getName()
    set {_x} to {_loc}.getBlockX()
    set {_y} to {_loc}.getBlockY()
    set {_z} to {_loc}.getBlockZ()
    return "%{_w}%_%{_x}%_%{_y}%_%{_z}%"

function mcwwsRemoveLightIconEntity(uuidText: text):
    set {_id} to UUID.fromString({_uuidText})
    set {_ent} to Bukkit.getEntity({_id})
    if {_ent} is set:
        if "%{_ent}%" is not "null":
            {_ent}.remove()

function mcwwsClearLightIcons(p: player):
    set {_puuid} to "%uuid of {_p}%"
    loop {mcwws.lightIcon::%{_puuid}%::*}:
        mcwwsRemoveLightIconEntity(loop-value)
        delete {mcwws.lightIcon::%{_puuid}%::%loop-index%}

function mcwwsSpawnLightIcon(p: player, block: object, key: text):
    set {_plugin} to Bukkit.getPluginManager().getPlugin("Skript")
    if {_plugin} is not set:
        stop
    set {_loc} to {_block}.getLocation().add(0.5, 0.5, 0.5)
    set {_world} to {_block}.getWorld()
    set {_display} to {_world}.spawn({_loc}, ItemDisplay.class)
    {_display}.setItemStack(mcwwsLightItemForLevel(mcwwsGetLightLevel({_block})))
    {_display}.setBillboard(Display.Billboard.CENTER)
    # ItemDisplay 默认朝向与 Billboard 相反，绕 Y 轴转 180° 正面朝向玩家
    {_display}.setTransformation(new Transformation(new Vector3f(0, 0, 0), new Quaternionf().rotationY(3.1415927), new Vector3f(1, 1, 1), new Quaternionf()))
    {_display}.setVisibleByDefault(false)
    {_display}.setShadowStrength(0)
    {_display}.setShadowRadius(0)
    {_p}.showEntity({_plugin}, {_display})
    set {_puuid} to "%uuid of {_p}%"
    set {mcwws.lightIcon::%{_puuid}%::%{_key}%} to {_display}.getUniqueId().toString()

# 手持光源：刷新附近光源格上的 ItemDisplay 图标（仅对该玩家可见）
function mcwwsRefreshLightIcons(p: player):
    set {_puuid} to "%uuid of {_p}%"
    delete {_needed::*}
    loop blocks in radius 8 around {_p}:
        if loop-block is light:
            set {_b} to loop-block
            set {_key} to mcwwsLightBlockKey({_b})
            set {_needed::%{_key}%} to true
            if {mcwws.lightIcon::%{_puuid}%::%{_key}%} is not set:
                mcwwsSpawnLightIcon({_p}, {_b}, {_key})
    loop {mcwws.lightIcon::%{_puuid}%::*}:
        set {_key} to loop-index
        if {_needed::%{_key}%} is not set:
            mcwwsRemoveLightIconEntity(loop-value)
            delete {mcwws.lightIcon::%{_puuid}%::%{_key}%}

every 1 tick:
    loop {mcwws.lightProtect::*}:
        remove 1 from {mcwws.lightProtect::%loop-index%}
        if {mcwws.lightProtect::%loop-index%} < 1:
            delete {mcwws.lightProtect::%loop-index%}
    loop {mcwws.recentPlace::*}:
        remove 1 from {mcwws.recentPlace::%loop-index%}
        if {mcwws.recentPlace::%loop-index%} < 1:
            delete {mcwws.recentPlace::%loop-index%}

every 10 ticks:
    loop all players:
        if tool of loop-player is light:
            mcwwsRefreshLightIcons(loop-player)
        else:
            mcwwsClearLightIcons(loop-player)

on quit:
    mcwwsClearLightIcons(player)
    delete {mcwws.recentPlace::%uuid of player%}

on unload:
    loop all players:
        mcwwsClearLightIcons(loop-player)
    delete {mcwws.lightProtect::*}
    delete {mcwws.recentPlace::*}

# 刚放下的光源短时保护，避免「潜行放置后立刻被拆除脚本拆成掉落物」
on place:
    set {mcwws.recentPlace::%uuid of player%} to 8
    if event-block is light:
        set {_key} to mcwwsLightBlockKey(event-block)
        set {mcwws.lightProtect::%{_key}%} to 10

on left click:
    if gamemode of player is creative:
        stop
    if gamemode of player is spectator:
        stop
    # 潜行时优先放置/交互，不触发拆除（与潜行右键放置冲突）
    if player is sneaking:
        stop
    set {_uuid} to "%uuid of player%"
    if {mcwws.recentPlace::%{_uuid}%} is set:
        stop
    set {_block} to mcwwsFindLookedLight(player, 5)
    if {_block} is not set:
        stop
    if "%{_block}%" is "null":
        stop
    set {_key} to mcwwsLightBlockKey({_block})
    if {mcwws.lightProtect::%{_key}%} is set:
        stop
    cancel event
    mcwwsBreakLightAsPlayer(player, {_block})

# 站立 + 手持光源 + 右键：循环亮度 0→15（同创造），潜行右键仍用于放置
on right click:
    if gamemode of player is creative:
        stop
    if gamemode of player is spectator:
        stop
    if player is sneaking:
        stop
    if tool of player is not light:
        stop
    set {_block} to mcwwsFindLookedLight(player, 5)
    if {_block} is not set:
        stop
    if "%{_block}%" is "null":
        stop
    cancel event
    mcwwsCycleLightLevel(player, {_block})
