# Slimefun 手持物品防放置。
# 原理：Slimefun 只有在 !(item instanceof NotPlaceable) 时才会把方块登记进 BlockStorage。
# 因此 NotPlaceable 物品一旦被当成原版方块放下，拆掉就只剩普通头颅/方块，特殊功能全丢。
#
# 例外：MultiBlockMachine（增强型合成台、磨石、矿石粉碎机、压缩机、装甲台、魔法工作台等）
# 同样是 NotPlaceable，但它们本来就要以原版方块形态摆出来、由 Slimefun 按结构识别，必须放行。
#
# 普通机器（货运管理器、太阳能板、电力冶炼炉、外卖柜等）不是 NotPlaceable，不受影响。
# 依赖 skript-reflect、Slimefun

import:
    io.github.thebusybiscuit.slimefun4.api.items.SlimefunItem
    io.github.thebusybiscuit.slimefun4.core.attributes.NotPlaceable
    io.github.thebusybiscuit.slimefun4.core.multiblocks.MultiBlockMachine
    org.bukkit.event.block.BlockPlaceEvent

# 需要拦截时返回物品显示名，否则返回空文本
function mcwwsHandheldSlimefunName(it: object) :: text:
    if {_it} is not set:
        return ""
    set {_sf} to SlimefunItem.getByItem({_it})
    if {_sf} is not set:
        return ""
    if {_sf} is instance of MultiBlockMachine:
        return ""
    set {_label} to {_sf}.getItemName()
    if {_sf} is instance of NotPlaceable:
        return "%{_label}%"
    set {_id} to {_sf}.getId()
    if "%{_id}%" starts with "PORTABLE_":
        return "%{_label}%"
    return ""

on BlockPlaceEvent with priority lowest:
    set {_name} to mcwwsHandheldSlimefunName(event.getItemInHand())
    if {_name} is "":
        stop
    event.setCancelled(true)
    send "§c%{_name}%§c 只能手持使用；放下再拆会丢失粘液科技功能，因此禁止放置。" to event.getPlayer()
