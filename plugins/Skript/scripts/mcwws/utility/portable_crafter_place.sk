# 便携式工作台：禁止放下。放下后史莱姆身份会丢，拆下来变成普通头颅/工作台。
# BanItem 3.7 在 Paper 26.2 会把版本误判成 <1.14，modeldata-equals 无法使用，因此改用史莱姆 PDC。

import:
    org.bukkit.NamespacedKey
    org.bukkit.persistence.PersistentDataType
    org.bukkit.event.block.BlockPlaceEvent

function mcwwsIsPortableCrafter(it: object) :: boolean:
    if {_it} is not set:
        return false
    if {_it} is air:
        return false
    set {_meta} to {_it}.getItemMeta()
    if {_meta} is not set:
        return false
    set {_key} to new NamespacedKey("slimefun", "slimefun_item")
    set {_id} to {_meta}.getPersistentDataContainer().get({_key}, PersistentDataType.STRING)
    if {_id} is "PORTABLE_CRAFTER":
        return true
    return false

on BlockPlaceEvent with priority lowest:
    if mcwwsIsPortableCrafter(event.getItemInHand()) is true:
        event.setCancelled(true)
        send "§c便携式工作台不能放下，请手持右键打开合成界面。" to event.getPlayer()
