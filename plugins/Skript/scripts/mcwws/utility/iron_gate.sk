# MCWWS：行政区西门大铁门（绕转角 90° 开合）
# 关：x=-720 z=104..125 y=64..66
# 开：x=-719..-698 z=103 y=64..66（北侧落地，不改转轴柱）
# 材质：与 z=103 一侧相同的 waxed_exposed_copper_bars
# 转轴：(-720, 103) 铜栏柱。右键转轴或关闭态门叶即可开关。

import:
    org.bukkit.Bukkit
    org.bukkit.Location
    org.bukkit.Material
    org.bukkit.Particle
    org.bukkit.Sound
    org.bukkit.SoundCategory
    org.bukkit.World
    org.bukkit.block.data.BlockData
    org.bukkit.entity.BlockDisplay
    org.bukkit.entity.Display
    org.bukkit.entity.Entity
    org.bukkit.util.Transformation
    org.joml.Quaternionf
    org.joml.Vector3f
    java.lang.Math
    java.util.UUID

function mcwwsIronGateWorld() :: object:
    set {_w} to Bukkit.getWorld("world")
    return {_w}

function mcwwsIronGateIsLeafCell(x: number, y: number, z: number) :: boolean:
    if {_y} < 64:
        return false
    if {_y} > 66:
        return false
    if {_x} is -720:
        if {_z} >= 104:
            if {_z} <= 125:
                return true
    if {_z} is 103:
        if {_x} >= -719:
            if {_x} <= -698:
                return true
    return false

function mcwwsIronGateBarDataEW() :: object:
    return Bukkit.createBlockData("minecraft:waxed_exposed_copper_bars[east=true,north=false,south=false,waterlogged=false,west=true]")

function mcwwsIronGateIsPivot(x: number, z: number) :: boolean:
    if {_x} is -720:
        if {_z} is 103:
            return true
    return false

function mcwwsIronGateBarData() :: object:
    return Bukkit.createBlockData("minecraft:waxed_exposed_copper_bars[east=false,north=true,south=true,waterlogged=false,west=false]")

function mcwwsIronGateIsBar(type: object) :: boolean:
    if {_type} is Material.WAXED_EXPOSED_COPPER_BARS:
        return true
    if {_type} is Material.IRON_BLOCK:
        return true
    return false

function mcwwsIronGateSetPivotSouth(connect: boolean):
    set {_w} to mcwwsIronGateWorld()
    if {_w} is not set:
        stop
    set {_y} to 64
    while {_y} <= 66:
        if {_connect} is true:
            {_w}.getBlockAt(-720, {_y}, 103).setBlockData(Bukkit.createBlockData("minecraft:waxed_exposed_copper_bars[east=true,north=true,south=true,waterlogged=false,west=false]"))
        else:
            {_w}.getBlockAt(-720, {_y}, 103).setBlockData(Bukkit.createBlockData("minecraft:waxed_exposed_copper_bars[east=true,north=true,south=false,waterlogged=false,west=false]"))
        add 1 to {_y}

function mcwwsIronGateClearDisplays():
    loop {mcwws.irongate.ents::*}:
        set {_id} to UUID.fromString("%loop-value%")
        set {_ent} to Bukkit.getEntity({_id})
        if {_ent} is set:
            {_ent}.remove()
    delete {mcwws.irongate.ents::*}
    delete {mcwws.irongate.d::*}
    delete {mcwws.irongate.y::*}

function mcwwsIronGateClearClosedBlocks():
    set {_w} to mcwwsIronGateWorld()
    if {_w} is not set:
        stop
    set {_z} to 104
    while {_z} <= 125:
        set {_y} to 64
        while {_y} <= 66:
            set {_b} to {_w}.getBlockAt(-720, {_y}, {_z})
            if mcwwsIronGateIsBar({_b}.getType()) is true:
                {_b}.setType(Material.AIR)
            add 1 to {_y}
        add 1 to {_z}
    mcwwsIronGateSetPivotSouth(false)

function mcwwsIronGatePlaceClosedBlocks():
    set {_w} to mcwwsIronGateWorld()
    if {_w} is not set:
        stop
    set {_data} to mcwwsIronGateBarData()
    set {_z} to 104
    while {_z} <= 125:
        set {_y} to 64
        while {_y} <= 66:
            set {_b} to {_w}.getBlockAt(-720, {_y}, {_z})
            if {_b}.getType() is Material.AIR:
                {_b}.setBlockData({_data})
            else:
                if mcwwsIronGateIsBar({_b}.getType()) is true:
                    {_b}.setBlockData({_data})
            add 1 to {_y}
        add 1 to {_z}
    mcwwsIronGateSetPivotSouth(true)

function mcwwsIronGateClearOpenBlocks():
    set {_w} to mcwwsIronGateWorld()
    if {_w} is not set:
        stop
    set {_x} to -719
    while {_x} <= -698:
        set {_y} to 64
        while {_y} <= 66:
            set {_b} to {_w}.getBlockAt({_x}, {_y}, 103)
            if mcwwsIronGateIsBar({_b}.getType()) is true:
                {_b}.setType(Material.AIR)
            add 1 to {_y}
        add 1 to {_x}

function mcwwsIronGatePlaceOpenBlocks():
    set {_w} to mcwwsIronGateWorld()
    if {_w} is not set:
        stop
    set {_data} to mcwwsIronGateBarDataEW()
    set {_x} to -719
    while {_x} <= -698:
        set {_y} to 64
        while {_y} <= 66:
            set {_b} to {_w}.getBlockAt({_x}, {_y}, 103)
            if {_b}.getType() is Material.AIR:
                {_b}.setBlockData({_data})
            else:
                if mcwwsIronGateIsBar({_b}.getType()) is true:
                    {_b}.setBlockData({_data})
            add 1 to {_y}
        add 1 to {_x}
    mcwwsIronGateSetPivotSouth(false)

function mcwwsIronGatePose(phi: number, d: number) :: object:
    set {_sin} to Math.sin({_phi})
    set {_cos} to Math.cos({_phi})
    set {_tx} to 0.5 + {_sin} * {_d} - 0.5 * {_cos} - 0.5 * {_sin}
    set {_tz} to 0.5 + {_cos} * {_d} + 0.5 * {_sin} - 0.5 * {_cos}
    return new Transformation(new Vector3f({_tx}, 0, {_tz}), new Quaternionf().rotationY({_phi}), new Vector3f(1, 1, 1), new Quaternionf())

function mcwwsIronGateSpawnDisplays(phi: number):
    mcwwsIronGateClearDisplays()
    set {_w} to mcwwsIronGateWorld()
    if {_w} is not set:
        stop
    set {_d} to 1
    while {_d} <= 22:
        set {_y} to 64
        while {_y} <= 66:
            set {_loc} to new Location({_w}, -720, {_y}, 103)
            set {_bd} to {_w}.spawn({_loc}, BlockDisplay.class)
            {_bd}.setBlock(mcwwsIronGateBarData())
            {_bd}.setTeleportDuration(0)
            {_bd}.setInterpolationDuration(2)
            {_bd}.setShadowRadius(0)
            {_bd}.setShadowStrength(0)
            {_bd}.setBrightness(new Display.Brightness(15, 15))
            {_bd}.setTransformation(mcwwsIronGatePose({_phi}, {_d}))
            set {_uuid} to {_bd}.getUniqueId().toString()
            add {_uuid} to {mcwws.irongate.ents::*}
            set {mcwws.irongate.d::%{_uuid}%} to {_d}
            add 1 to {_y}
        add 1 to {_d}

function mcwwsIronGateMoveDisplays(phi: number):
    loop {mcwws.irongate.ents::*}:
        set {_uuid} to loop-value
        set {_id} to UUID.fromString("%{_uuid}%")
        set {_ent} to Bukkit.getEntity({_id})
        if {_ent} is not set:
            continue
        set {_d} to {mcwws.irongate.d::%{_uuid}%}
        {_ent}.setInterpolationDuration(2)
        {_ent}.setTransformation(mcwwsIronGatePose({_phi}, {_d}))

function mcwwsIronGateFinish():
    set {mcwws.irongate.busy} to false
    set {mcwws.irongate.frame} to 0
    mcwwsIronGateClearDisplays()
    if {mcwws.irongate.dir} is "close":
        mcwwsIronGatePlaceClosedBlocks()
        set {mcwws.irongate.open} to false
    else:
        mcwwsIronGatePlaceOpenBlocks()
        set {mcwws.irongate.open} to true
    set {_w} to mcwwsIronGateWorld()
    if {_w} is set:
        set {_loc} to new Location({_w}, -720.5, 65, 103.5)
        {_w}.playSound({_loc}, Sound.BLOCK_IRON_DOOR_CLOSE, SoundCategory.BLOCKS, 1, 0.7)
        {_w}.spawnParticle(Particle.CRIT, {_loc}, 12, 0.4, 0.6, 0.4, 0.02)

function mcwwsIronGateStart(dir: text):
    if {mcwws.irongate.busy} is true:
        stop
    if {_dir} is "open":
        if {mcwws.irongate.open} is true:
            stop
    if {_dir} is "close":
        if {mcwws.irongate.open} is false:
            if {mcwws.irongate.open} is set:
                stop
    set {mcwws.irongate.busy} to true
    set {mcwws.irongate.dir} to {_dir}
    set {mcwws.irongate.frame} to 0
    set {_w} to mcwwsIronGateWorld()
    set {_loc} to new Location({_w}, -720.5, 65, 103.5)
    {_w}.playSound({_loc}, Sound.BLOCK_IRON_DOOR_OPEN, SoundCategory.BLOCKS, 1, 0.85)
    if {_dir} is "open":
        mcwwsIronGateClearClosedBlocks()
        mcwwsIronGateSpawnDisplays(0)
    else:
        mcwwsIronGateClearOpenBlocks()
        mcwwsIronGateSpawnDisplays(1.5707964)

function mcwwsIronGateToggle():
    if {mcwws.irongate.busy} is true:
        stop
    if {mcwws.irongate.open} is false:
        mcwwsIronGateStart("open")
    else:
        mcwwsIronGateStart("close")

on script load:
    set {mcwws.irongate.busy} to false
    set {mcwws.irongate.frame} to 0
    if {mcwws.irongate.open} is not set:
        set {mcwws.irongate.open} to true
    mcwwsIronGateClearDisplays()

on script unload:
    mcwwsIronGateClearDisplays()

every 1 tick:
    if {mcwws.irongate.busy} is true:
        add 1 to {mcwws.irongate.frame}
        if {mcwws.irongate.frame} >= 49:
            mcwwsIronGateFinish()
        else:
            set {_t} to {mcwws.irongate.frame} / 48
            if {mcwws.irongate.dir} is "open":
                set {_phi} to {_t} * 1.5707964
            else:
                set {_phi} to (1 - {_t}) * 1.5707964
            mcwwsIronGateMoveDisplays({_phi})

command /mcwws-irongate [<text>]:
    description: 行政区西门大铁门开合
    executable by: players and console
    trigger:
        set {_a} to arg-1
        if {_a} is not set:
            set {_a} to "toggle"
        if {_a} is "status":
            send "&7铁门：open=%{mcwws.irongate.open}% busy=%{mcwws.irongate.busy}%" to sender
            stop
        if {_a} is "toggle":
            mcwwsIronGateToggle()
            stop
        if {_a} is "open":
            mcwwsIronGateStart("open")
            stop
        if {_a} is "close":
            mcwwsIronGateStart("close")
            stop
        send "&c用法：/mcwws-irongate toggle|open|close|status" to sender

on right click:
    if player is not set:
        stop
    if {mcwws.irongate.busy} is true:
        stop
    set {_b} to clicked block
    if {_b} is not set:
        stop
    set {_x} to x-coord of {_b}
    set {_y} to y-coord of {_b}
    set {_z} to z-coord of {_b}
    if mcwwsIronGateIsPivot({_x}, {_z}) is true:
        if {_y} >= 64:
            if {_y} <= 67:
                mcwwsIronGateToggle()
                cancel event
                stop
    if mcwwsIronGateIsLeafCell({_x}, {_y}, {_z}) is true:
        if mcwwsIronGateIsBar({_b}.getType()) is true:
            mcwwsIronGateToggle()
            cancel event
            stop

on break:
    if mcwwsIronGateIsLeafCell(x-coord of event-block, y-coord of event-block, z-coord of event-block) is true:
        if mcwwsIronGateIsBar(event-block.getType()) is true:
            if player is not op:
                cancel event
