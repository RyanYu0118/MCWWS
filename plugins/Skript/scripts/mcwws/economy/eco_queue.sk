# 网页商城：Essentials 零钱扣款队列（统一写 userdata，在线时用 eco set 同步内存）

function mcwwsEcoQueueMaxId() :: number:
    load yaml "plugins/Skript/scripts/web/data/economy_deductions.yml" as "econq"
    set {_max} to yaml value "next_id" from "econq"
    unload yaml "econq"
    if {_max} is not set:
        return 0
    if {_max} <= 1:
        return 0
    return {_max} - 1

function mcwwsFormatEssentialsMoney(amount: number) :: text:
    set {_t} to round({_amount} * 100)
    set {_d} to floor({_t} / 100)
    set {_c} to mod({_t}, 100)
    if {_c} < 10:
        return "%{_d}%.0%{_c}%"
    return "%{_d}%.%{_c}%"

function mcwwsIsPlayerOnline(playerId: text) :: boolean:
    set {_key} to {_playerId} in lower case
    loop all players:
        if name of loop-player in lower case is {_key}:
            return true
    return false

function mcwwsReadEssentialsFileMoney(uuid: text) :: number:
    set {_path} to "plugins/Essentials/userdata/%{_uuid}%.yml"
    if yaml file {_path} exists:
        load yaml {_path} as "eu"
    else:
        return -1
    set {_moneyRaw} to yaml value "money" from "eu"
    unload yaml "eu"
    set {_money} to {_moneyRaw} parsed as number
    if {_money} is not set:
        return 0
    return {_money}

function mcwwsWriteEssentialsFileMoney(uuid: text, amount: number) :: boolean:
    set {_path} to "plugins/Essentials/userdata/%{_uuid}%.yml"
    if yaml file {_path} exists:
        load yaml {_path} as "eu"
    else:
        return false
    set yaml value "money" from "eu" to mcwwsFormatEssentialsMoney({_amount})
    save yaml "eu"
    unload yaml "eu"
    return true

function mcwwsDeductEssentialsOffline(uuid: text, amount: number) :: boolean:
    set {_money} to mcwwsReadEssentialsFileMoney({_uuid})
    if {_money} < 0:
        return false
    if {_money} < {_amount}:
        return false
    set {_new} to {_money} - {_amount}
    return mcwwsWriteEssentialsFileMoney({_uuid}, {_new})

function mcwwsEcoSetFromFile(playerId: text, uuid: text):
    set {_path} to "plugins/Essentials/userdata/%{_uuid}%.yml"
    if yaml file {_path} exists:
        load yaml {_path} as "eu"
    else:
        stop
    set {_moneyRaw} to yaml value "money" from "eu"
    unload yaml "eu"
    if {_moneyRaw} is not set:
        stop
    execute console command "eco set %{_playerId}% %{_moneyRaw}%"

function mcwwsEcoBalanceMatchesTarget(uuid: text, targetRaw: text) :: boolean:
    if {_targetRaw} is not set:
        return false
    if "%{_targetRaw}%" is "":
        return false
    set {_target} to {_targetRaw} parsed as number
    if {_target} is not set:
        return false
    set {_current} to mcwwsReadEssentialsFileMoney({_uuid})
    if {_current} < 0:
        return false
    set {_diff} to {_current} - {_target}
    if {_diff} < 0:
        set {_diff} to 0 - {_diff}
    if {_diff} < 0.02:
        return true
    return false

function mcwwsMarkEcoDeductionDone(id: number):
    set yaml value "pending.%{_id}%.status" from "econq" to "done"
    set yaml value "pending.%{_id}%.processedAt" from "econq" to now formatted as "yyyy-MM-dd HH:mm:ss"

function mcwwsApplyEcoDeduction(id: number, pid: text, uuid: text, amount: number, targetRaw: text) :: boolean:
    if mcwwsEcoBalanceMatchesTarget({_uuid}, {_targetRaw}) is true:
        return true
    if mcwwsDeductEssentialsOffline({_uuid}, {_amount}) is true:
        return true
    if mcwwsEcoBalanceMatchesTarget({_uuid}, {_targetRaw}) is true:
        return true
    return false

function mcwwsProcessEcoQueue():
    set {_limit} to mcwwsEcoQueueMaxId()
    if {_limit} <= 0:
        stop
    load yaml "plugins/Skript/scripts/web/data/economy_deductions.yml" as "econq"
    set {_changed} to false
    loop {_limit} times:
        set {_id} to loop-number
        set {_status} to yaml value "pending.%{_id}%.status" from "econq"
        if "%{_status}%" is not "pending":
            continue
        set {_pid} to yaml value "pending.%{_id}%.playerId" from "econq"
        set {_uuid} to yaml value "pending.%{_id}%.uuid" from "econq"
        set {_amount} to yaml value "pending.%{_id}%.amount" from "econq"
        set {_target} to yaml value "pending.%{_id}%.balanceAfter" from "econq"
        if {_pid} is not set:
            continue
        if {_uuid} is not set:
            continue
        if {_amount} is not set:
            continue
        if mcwwsApplyEcoDeduction({_id}, {_pid}, {_uuid}, {_amount}, {_target}) is false:
            continue
        if mcwwsIsPlayerOnline({_pid}) is true:
            mcwwsEcoSetFromFile({_pid}, {_uuid})
        mcwwsMarkEcoDeductionDone({_id})
        set {_changed} to true
    if {_changed} is true:
        save yaml "econq"
    unload yaml "econq"

function mcwwsProcessEcoQueueForUuid(uuid: text):
    set {_key} to "%{_uuid}%" in lower case
    set {_limit} to mcwwsEcoQueueMaxId()
    if {_limit} <= 0:
        stop
    load yaml "plugins/Skript/scripts/web/data/economy_deductions.yml" as "econq"
    set {_changed} to false
    loop {_limit} times:
        set {_id} to loop-number
        set {_status} to yaml value "pending.%{_id}%.status" from "econq"
        if "%{_status}%" is not "pending":
            continue
        set {_entryUuid} to yaml value "pending.%{_id}%.uuid" from "econq"
        if "%{_entryUuid}%" in lower case is not {_key}:
            continue
        set {_pid} to yaml value "pending.%{_id}%.playerId" from "econq"
        set {_amount} to yaml value "pending.%{_id}%.amount" from "econq"
        set {_target} to yaml value "pending.%{_id}%.balanceAfter" from "econq"
        if {_pid} is not set:
            continue
        if {_amount} is not set:
            continue
        if mcwwsApplyEcoDeduction({_id}, {_pid}, {_entryUuid}, {_amount}, {_target}) is false:
            continue
        if mcwwsIsPlayerOnline({_pid}) is true:
            mcwwsEcoSetFromFile({_pid}, {_entryUuid})
        mcwwsMarkEcoDeductionDone({_id})
        set {_changed} to true
    if {_changed} is true:
        save yaml "econq"
    unload yaml "econq"

on load:
    send "§a[MCWWS] 网页零钱扣款队列已启用。" to console

every 3 seconds:
    mcwwsProcessEcoQueue()

on join:
    wait 2 seconds
    mcwwsProcessEcoQueueForUuid("%uuid of player%")

on quit:
    mcwwsProcessEcoQueueForUuid("%uuid of player%")
