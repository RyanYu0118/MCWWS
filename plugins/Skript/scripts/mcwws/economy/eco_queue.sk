# 网页商城：Node 已写 Essentials userdata；本脚本把在线玩家的游戏内余额与文件对齐（Vault + eco）

function mcwwsEcoQueueMaxId() :: number:
    load yaml "plugins/Skript/scripts/web/data/economy_deductions.yml" as "econq"
    set {_max} to yaml value "next_id" from "econq"
    unload yaml "econq"
    if {_max} is not set:
        return 0
    if {_max} <= 1:
        return 0
    return {_max} - 1

function mcwwsFormatMoney(amount: number) :: text:
    set {_t} to round({_amount} * 100)
    set {_d} to floor({_t} / 100)
    set {_c} to mod({_t}, 100)
    if {_c} < 10:
        return "%{_d}%.0%{_c}%"
    return "%{_d}%.%{_c}%"

function mcwwsIsPlayerOnline(playerId: text) :: boolean:
    set {_key} to {_playerId} in lower case
    loop all players:
        if name of loop-player in lower case is {_key}:
            return true
    return false

function mcwwsReadEssentialsFileMoney(uuid: text) :: number:
    set {_path} to "plugins/Essentials/userdata/%{_uuid}%.yml"
    if yaml file {_path} exists:
        load yaml {_path} as "eu"
    else:
        return -1
    set {_moneyRaw} to yaml value "money" from "eu"
    unload yaml "eu"
    set {_money} to {_moneyRaw} parsed as number
    if {_money} is not set:
        return 0
    return {_money}

function mcwwsEntryNeedsMemorySync(id: number) :: boolean:
    set {_syncRaw} to yaml value "pending.%{_id}%.needsMemorySync" from "econq"
    if {_syncRaw} is true:
        return true
    set {_syncText} to "%{_syncRaw}%"
    if {_syncText} is "true":
        return true
    set {_syncedAt} to yaml value "pending.%{_id}%.memorySyncedAt" from "econq"
    if {_syncedAt} is set:
        return false
    set {_mode} to yaml value "pending.%{_id}%.mode" from "econq"
    set {_modeText} to "%{_mode}%"
    if {_modeText} contains "file":
        return true
    return false

function mcwwsSyncInGameBalance(playerId: text, uuid: text) :: boolean:
    set {_key} to {_playerId} in lower case
    set {_file} to mcwwsReadEssentialsFileMoney({_uuid})
    if {_file} < 0:
        return false
    loop all players:
        if name of loop-player in lower case is not {_key}:
            continue
        set balance of loop-player to {_file}
        set {_mem} to balance of loop-player
        if {_mem} > {_file} + 0.01:
            set {_delta} to {_mem} - {_file}
            execute console command "eco take %{_playerId}% %mcwwsFormatMoney({_delta})%"
        else if {_mem} < {_file} - 0.01:
            set {_delta} to {_file} - {_mem}
            execute console command "eco give %{_playerId}% %mcwwsFormatMoney({_delta})%"
        return true
    return false

function mcwwsMarkMemorySynced(id: number):
    set yaml value "pending.%{_id}%.needsMemorySync" from "econq" to false
    set yaml value "pending.%{_id}%.memorySyncedAt" from "econq" to now formatted as "yyyy-MM-dd HH:mm:ss"

function mcwwsProcessEcoMemorySync():
    set {_limit} to mcwwsEcoQueueMaxId()
    if {_limit} <= 0:
        stop
    load yaml "plugins/Skript/scripts/web/data/economy_deductions.yml" as "econq"
    set {_changed} to false
    loop {_limit} times:
        set {_id} to loop-number
        if mcwwsEntryNeedsMemorySync({_id}) is false:
            continue
        set {_pid} to yaml value "pending.%{_id}%.playerId" from "econq"
        set {_uuid} to yaml value "pending.%{_id}%.uuid" from "econq"
        if {_pid} is not set:
            continue
        if {_uuid} is not set:
            continue
        if mcwwsIsPlayerOnline({_pid}) is false:
            continue
        if mcwwsSyncInGameBalance({_pid}, {_uuid}) is false:
            continue
        mcwwsMarkMemorySynced({_id})
        send "§a[MCWWS] 已同步玩家 %{_pid}% 游戏内零钱（订单扣款 #%{_id}%）" to console
        set {_changed} to true
    if {_changed} is true:
        save yaml "econq"
    unload yaml "econq"

function mcwwsProcessEcoMemorySyncForUuid(uuid: text):
    set {_key} to "%{_uuid}%" in lower case
    set {_limit} to mcwwsEcoQueueMaxId()
    if {_limit} <= 0:
        stop
    load yaml "plugins/Skript/scripts/web/data/economy_deductions.yml" as "econq"
    set {_changed} to false
    loop {_limit} times:
        set {_id} to loop-number
        set {_entryUuid} to yaml value "pending.%{_id}%.uuid" from "econq"
        if "%{_entryUuid}%" in lower case is not {_key}:
            continue
        if mcwwsEntryNeedsMemorySync({_id}) is false:
            continue
        set {_pid} to yaml value "pending.%{_id}%.playerId" from "econq"
        if {_pid} is not set:
            continue
        if mcwwsIsPlayerOnline({_pid}) is false:
            continue
        if mcwwsSyncInGameBalance({_pid}, {_entryUuid}) is false:
            continue
        mcwwsMarkMemorySynced({_id})
        send "§a[MCWWS] 已同步玩家 %{_pid}% 游戏内零钱（订单扣款 #%{_id}%）" to console
        set {_changed} to true
    if {_changed} is true:
        save yaml "econq"
    unload yaml "econq"

on load:
    send "§a[MCWWS] 网页零钱同步队列已启用。" to console

every 2 seconds:
    mcwwsProcessEcoMemorySync()

on join:
    wait 5 ticks
    mcwwsSyncInGameBalance(name of player, "%uuid of player%")
    wait 1 second
    mcwwsProcessEcoMemorySyncForUuid("%uuid of player%")
