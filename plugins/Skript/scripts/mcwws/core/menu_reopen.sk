# MCWWS：插件重载后恢复 DeluxeMenus「服务器管理」界面
# - cc/shop/dm reload：Skript wait 可跨过这些插件重载
# - sk reload all：wait 会被中断，改由本脚本 on load 读取持久变量再打开

function mcwwsTryReopenServerMenu(playerName: text):
    set {_key} to "%{_playerName}%"
    if {mcwws.reopenServerMenu::%{_key}%} is not set:
        stop
    delete {mcwws.reopenServerMenu::%{_key}%}
    set {_p} to {_key} parsed as offline player
    if {_p} is not set:
        stop
    if {_p} is not online:
        stop
    execute console command "dm open server %name of {_p}%"

command /mcwws_queue_reopen_server [<text>]:
    executable by: console
    trigger:
        if arg-1 is not set:
            stop
        set {_name} to "%arg-1%"
        set {mcwws.reopenServerMenu::%{_name}%} to true
        # 非 sk reload：约 2.5 秒后重开；sk reload all 会取消此 wait，改走 on load
        wait 50 ticks
        mcwwsTryReopenServerMenu({_name})

on load:
    wait 40 ticks
    loop {mcwws.reopenServerMenu::*}:
        mcwwsTryReopenServerMenu("%loop-index%")
