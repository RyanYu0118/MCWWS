# MCWWS 网页商城：待领取订单 → 直接写入 BetterBags（需 skript-yaml + skript-reflect + BetterBags）
import:
    org.bukkit.Material
    org.bukkit.inventory.ItemStack
    cat.necko.bags.Plugin as BetterBagsPlugin

function mcwwsInitPendingOrders():
    load yaml "plugins/Skript/scripts/web/data/pending_orders.yml" as "weborders"
    if yaml value "next_id" from "weborders" is not set:
        set yaml value "next_id" from "weborders" to 1
        save yaml "weborders"
        send "§a[MCWWS] 已创建网页待领取订单 YAML。" to console
    else:
        send "§a[MCWWS] 网页待领取订单发放已启用。" to console
    unload yaml "weborders"

function mcwwsUuidKey(u: text) :: text:
    set {_s} to "%{_u}%"
    set {_s} to {_s} in lower case
    return {_s}

function mcwwsPlayerUuidKey(p: player) :: text:
    return mcwwsUuidKey("%uuid of {_p}%")

# skript-yaml 列表下标从 1 开始；Node 写入的 lines 数组对应 lines.1、lines.2 …
function mcwwsLineYamlIndex(lineIdx: number) :: text:
    set {_i} to {_lineIdx} + 1
    return "%{_i}%"

function mcwwsWebOrdersMaxId() :: number:
    load yaml "plugins/Skript/scripts/web/data/pending_orders.yml" as "weborders"
    set {_max} to yaml value "next_id" from "weborders"
    unload yaml "weborders"
    if {_max} is not set:
        return 0
    if {_max} <= 1:
        return 0
    return {_max} - 1

# 从 skript-yaml 列表项的 loop-val 文本解析字段（形如 {shopId=flowers, slot=Q, ...}）
function mcwwsParseLineMapField(raw: text, field: text) :: text:
    set {_needle} to "%{_field}%="
    if "%{_raw}%" does not contain {_needle}:
        return ""
    set {_parts::*} to {_raw} split at ", "
    loop {_parts::*}:
        if loop-value contains {_needle}:
            set {_i} to index of {_needle} in loop-value
            set {_start} to {_i} + length of {_needle}
            set {_v} to subtext of loop-value from {_start} to length of loop-value
            return {_v}
    return ""

function mcwwsReadLineValue(oid: text, lineIdx: number, field: text) :: text:
    set {_key} to mcwwsLineYamlIndex({_lineIdx})
    set {_base} to "orders.%{_oid}%.lines"
    set {_path} to "%{_base}%.%{_key}%.%{_field}%"
    set {_val} to yaml value {_path} from "weborders"
    if {_val} is set:
        return "%{_val}%"
    set {_path2} to "%{_base}%.%{_lineIdx}%.%{_field}%"
    set {_val2} to yaml value {_path2} from "weborders"
    if {_val2} is set:
        return "%{_val2}%"
    # Node js-yaml 列表（- item）：loop-val 为 {shopId=..., slot=...}
    if yaml node {_base} from "weborders" does not have list:
        return ""
    set {_n} to 0
    loop yaml list {_base} from "weborders":
        if {_n} is {_lineIdx}:
            set {_parsed} to mcwwsParseLineMapField("%loop-val%", {_field})
            if {_parsed} is not "":
                return {_parsed}
            stop loop
        add 1 to {_n}
    return ""

function mcwwsParseLineNumber(raw: text, default: number) :: number:
    set {_s} to "%{_raw}%"
    if {_s} is "":
        return {_default}
    set {_n} to {_s} parsed as number
    if {_n} is not set:
        return {_default}
    return {_n}

# 金额格式使用 mcwws/economy/eco_queue.sk 中的 mcwwsFormatMoney

# 发放前必须 eco take 成功（不信任旧的 file-checkout / 假 done 记录）
function mcwwsEnsureOrderEconomyCharged(p: player, oid: text):
    set {_uuid} to mcwwsPlayerUuidKey({_p})
    set {mcwws.webdeliver.economyOk::%{_uuid}%} to true
    load yaml "plugins/Skript/scripts/web/data/pending_orders.yml" as "weborders"
    set {_chargedRaw} to yaml value "orders.%{_oid}%.economyChargedInGame" from "weborders"
    set {_total} to yaml value "orders.%{_oid}%.total" from "weborders"
    unload yaml "weborders"
    set {_chargedText} to "%{_chargedRaw}%"
    if {_chargedRaw} is true:
        stop
    if {_chargedText} is "true":
        stop
    set {_totalNum} to {_total} parsed as number
    if {_totalNum} is not set:
        set {_totalNum} to 0
    if {_totalNum} <= 0:
        stop
    set {_pname} to name of {_p}
    loop 8 times:
        if mcwwsIsEcoTakeDoneForOrder({_oid}) is true:
            stop
        wait 1 second
    mcwwsRunEcoTakeCommand({_pname}, {_totalNum})
    wait 10 ticks
    if yaml file "plugins/Skript/scripts/web/data/pending_orders.yml" exists:
        load yaml "plugins/Skript/scripts/web/data/pending_orders.yml" as "weborders"
        set yaml value "orders.%{_oid}%.economyChargedInGame" from "weborders" to true
        set yaml value "orders.%{_oid}%.updatedAt" from "weborders" to now formatted as "yyyy-MM-dd HH:mm:ss"
        save yaml "weborders"
        unload yaml "weborders"
    set {_path} to "plugins/Skript/scripts/web/data/economy_deductions.yml"
    if yaml file {_path} exists:
        reload yaml {_path} as "econq"
        set {_max} to yaml value "next_id" from "econq"
        if {_max} is set:
            set {_limit} to {_max} - 1
            loop {_limit} times:
                set {_eid} to loop-number
                set {_ek} to "%{_eid}%"
                set {_eoid} to yaml value "pending.%{_ek}%.orderId" from "econq"
                if "%{_eoid}%" is not "%{_oid}%":
                    continue
                set yaml value "pending.%{_ek}%.status" from "econq" to "done"
                set yaml value "pending.%{_ek}%.mode" from "econq" to "eco-take"
                set yaml value "pending.%{_ek}%.processedAt" from "econq" to now formatted as "yyyy-MM-dd HH:mm:ss"
            save yaml "econq"
        unload yaml "econq"

function mcwwsDeliverItemToBetterBags(p: player, material: text, amount: number) :: boolean:
    if {_amount} <= 0:
        return false
    set {_mat} to "%{_material}%"
    if {_mat} is "":
        return false
    if {_mat} does not contain "minecraft:":
        set {_mat} to "minecraft:%{_mat}%"
    set {_bukkitMat} to Material.matchMaterial({_mat})
    if {_bukkitMat} is not set:
        set {_plain} to {_mat}
        replace all "minecraft:" in {_plain} with ""
        set {_bukkitMat} to Material.matchMaterial({_plain})
    if {_bukkitMat} is not set:
        return false
    set {_stack} to new ItemStack({_bukkitMat}, {_amount})
    set {_plugin} to BetterBagsPlugin.getInstance()
    if {_plugin} is not set:
        return false
    set {_pd} to {_plugin}.getPlayerData(uuid of {_p})
    if {_pd} is not set:
        return false
    set {_left} to {_pd}.addItem({_stack})
    if {_left} is set:
        if {_left}.isEmpty() is false:
            return false
    {_pd}.save()
    execute console command "betterbags:bags save"
    return true

function mcwwsFailOrderDelivery(p: player, oid: text, reason: text):
    load yaml "plugins/Skript/scripts/web/data/pending_orders.yml" as "weborders"
    set yaml value "orders.%{_oid}%.status" from "weborders" to "pending"
    set yaml value "orders.%{_oid}%.failureReason" from "weborders" to {_reason}
    set yaml value "orders.%{_oid}%.updatedAt" from "weborders" to now formatted as "yyyy-MM-dd HH:mm:ss"
    save yaml "weborders"
    unload yaml "weborders"
    delete {mcwws.webdeliver.active::%mcwwsPlayerUuidKey({_p})%}
    delete {mcwws.webdeliver.line::%mcwwsPlayerUuidKey({_p})%}
    send "§c[MCWWS] §f网页订单 §e#%{_oid}% §f发放失败：%{_reason}%" to {_p}

function mcwwsResetStaleDelivering():
    set {_limit} to mcwwsWebOrdersMaxId()
    if {_limit} <= 0:
        stop
    load yaml "plugins/Skript/scripts/web/data/pending_orders.yml" as "weborders"
    loop {_limit} times:
        set {_oid} to loop-number
        set {_status} to yaml value "orders.%{_oid}%.status" from "weborders"
        if "%{_status}%" is not "delivering":
            continue
        set {_started} to yaml value "orders.%{_oid}%.deliveringStartedAt" from "weborders"
        if {_started} is not set:
            set yaml value "orders.%{_oid}%.status" from "weborders" to "pending"
            continue
        set {_elapsed} to difference between now and {_started}
        if {_elapsed} <= 120 seconds:
            continue
        set yaml value "orders.%{_oid}%.status" from "weborders" to "pending"
        set yaml value "orders.%{_oid}%.failureReason" from "weborders" to "发放超时，将在下次上线重试"
        set yaml value "orders.%{_oid}%.updatedAt" from "weborders" to now formatted as "yyyy-MM-dd HH:mm:ss"
        set {_ouuid} to yaml value "orders.%{_oid}%.playerUuid" from "weborders"
        delete {mcwws.webdeliver.active::%mcwwsUuidKey({_ouuid})%}
        delete {mcwws.webdeliver.line::%mcwwsUuidKey({_ouuid})%}
    save yaml "weborders"
    unload yaml "weborders"

function mcwwsDeliverOrderLine(p: player, oid: text, lineIdx: number):
    reload yaml "plugins/Skript/scripts/web/data/pending_orders.yml" as "weborders"
    set {_material} to mcwwsReadLineValue({_oid}, {_lineIdx}, "material")
    if {_material} is "":
        set {_material} to mcwwsReadLineValue({_oid}, {_lineIdx}, "itemId")
    if {_material} is "":
        mcwwsFailOrderDelivery({_p}, {_oid}, "无法读取物品 ID（YAML 行 %{_lineIdx}%）")
        unload yaml "weborders"
        stop
    set {_qty} to mcwwsParseLineNumber(mcwwsReadLineValue({_oid}, {_lineIdx}, "quantity"), 1)
    set {_per} to mcwwsParseLineNumber(mcwwsReadLineValue({_oid}, {_lineIdx}, "productAmount"), 1)
    set {_total} to {_qty} * {_per}
    set {_ok} to mcwwsDeliverItemToBetterBags({_p}, {_material}, {_total})
    if {_ok} is false:
        mcwwsFailOrderDelivery({_p}, {_oid}, "BetterBags 发放失败（未加载数据或容量不足），请重新登录后重试")
        unload yaml "weborders"
        stop
    set {_lineKey} to mcwwsLineYamlIndex({_lineIdx})
    set yaml value "orders.%{_oid}%.lines.%{_lineKey}%.status" from "weborders" to "delivered"
    set yaml value "orders.%{_oid}%.updatedAt" from "weborders" to now formatted as "yyyy-MM-dd HH:mm:ss"
    save yaml "weborders"
    unload yaml "weborders"
    add 1 to {_lineIdx}
    wait 3 ticks
    mcwwsAdvanceDelivery({_p}, {_oid}, {_lineIdx})

function mcwwsAdvanceDelivery(p: player, oid: text, nextLineIdx: number):
    set {_uuid} to mcwwsPlayerUuidKey({_p})
    if {_oid} is not set:
        mcwwsTryStartNextOrder({_p})
        stop
    load yaml "plugins/Skript/scripts/web/data/pending_orders.yml" as "weborders"
    set {_lineCount} to yaml value "orders.%{_oid}%.lineCount" from "weborders"
    if {_lineCount} is not set:
        set {_lineCount} to 1
    if {_nextLineIdx} >= {_lineCount}:
        set yaml value "orders.%{_oid}%.status" from "weborders" to "delivered"
        set yaml value "orders.%{_oid}%.updatedAt" from "weborders" to now formatted as "yyyy-MM-dd HH:mm:ss"
        set yaml value "orders.%{_oid}%.failureReason" from "weborders" to ""
        save yaml "weborders"
        unload yaml "weborders"
        delete {mcwws.webdeliver.active::%{_uuid}%}
        delete {mcwws.webdeliver.line::%{_uuid}%}
        send "§a[MCWWS] §f网页订单 §e#%{_oid}% §f已发放至 BetterBags。" to {_p}
        wait 5 ticks
        mcwwsTryStartNextOrder({_p})
        stop
    set {mcwws.webdeliver.line::%{_uuid}%} to {_nextLineIdx}
    set yaml value "orders.%{_oid}%.deliveringLine" from "weborders" to {_nextLineIdx}
    save yaml "weborders"
    unload yaml "weborders"
    wait 10 ticks
    mcwwsDeliverOrderLine({_p}, {_oid}, {_nextLineIdx})

function mcwwsTryStartNextOrder(p: player):
    set {_uuid} to mcwwsPlayerUuidKey({_p})
    if {mcwws.webdeliver.active::%{_uuid}%} is set:
        stop
    set {_limit} to mcwwsWebOrdersMaxId()
    if {_limit} <= 0:
        stop
    load yaml "plugins/Skript/scripts/web/data/pending_orders.yml" as "weborders"
    set {_target} to ""
    loop {_limit} times:
        set {_oid} to loop-number
        set {_status} to yaml value "orders.%{_oid}%.status" from "weborders"
        if "%{_status}%" is "delivering":
            set {_ouuid} to yaml value "orders.%{_oid}%.playerUuid" from "weborders"
            if mcwwsUuidKey({_ouuid}) is {_uuid}:
                if {mcwws.webdeliver.active::%{_uuid}%} is not set:
                    set yaml value "orders.%{_oid}%.status" from "weborders" to "pending"
                    set yaml value "orders.%{_oid}%.failureReason" from "weborders" to "上次发放中断，正在重试"
            continue
        if "%{_status}%" is not "pending":
            continue
        set {_ouuid} to yaml value "orders.%{_oid}%.playerUuid" from "weborders"
        if mcwwsUuidKey({_ouuid}) is not {_uuid}:
            continue
        set {_target} to "%{_oid}%"
        exit loop
    if {_target} is "":
        unload yaml "weborders"
        stop
    unload yaml "weborders"
    delete {mcwws.webdeliver.economyOk::%{_uuid}%}
    mcwwsEnsureOrderEconomyCharged({_p}, {_target})
    if {mcwws.webdeliver.economyOk::%{_uuid}%} is false:
        delete {mcwws.webdeliver.economyOk::%{_uuid}%}
        stop
    delete {mcwws.webdeliver.economyOk::%{_uuid}%}
    load yaml "plugins/Skript/scripts/web/data/pending_orders.yml" as "weborders"
    set yaml value "orders.%{_target}%.status" from "weborders" to "delivering"
    set yaml value "orders.%{_target}%.deliveringLine" from "weborders" to 0
    set yaml value "orders.%{_target}%.deliveringStartedAt" from "weborders" to now formatted as "yyyy-MM-dd HH:mm:ss"
    set yaml value "orders.%{_target}%.updatedAt" from "weborders" to now formatted as "yyyy-MM-dd HH:mm:ss"
    set yaml value "orders.%{_target}%.failureReason" from "weborders" to ""
    save yaml "weborders"
    unload yaml "weborders"
    set {mcwws.webdeliver.active::%mcwwsPlayerUuidKey({_p})%} to {_target}
    set {mcwws.webdeliver.line::%mcwwsPlayerUuidKey({_p})%} to 0
    send "§a[MCWWS] §f正在发放网页订单 §e#%{_target}% §f至 BetterBags..." to {_p}
    wait 5 ticks
    mcwwsDeliverOrderLine({_p}, {_target}, 0)

function mcwwsDeliverPendingFor(p: player):
    mcwwsTryStartNextOrder({_p})

on load:
    mcwwsInitPendingOrders()

on join:
    wait 3 seconds
    mcwwsDeliverPendingFor(player)

every 15 seconds:
    mcwwsResetStaleDelivering()
    loop all players:
        mcwwsDeliverPendingFor(loop-player)

