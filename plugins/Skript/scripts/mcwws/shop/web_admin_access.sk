# 将 Minecraft 侧的管理权限导出给网页管理面板读取。
# 网页端仍会直接读取 ops.json；此文件主要用于同步 LuckPerms/插件权限节点。
# 不用 skript-yaml 写盘：admin_access.yml 不存在时 save 会在主线程 NPE，原先每 15 秒对全体在线玩家各写一次，表现为周期性卡顿。

import:
    java.io.File
    java.nio.file.Files
    java.nio.charset.StandardCharsets

function mcwwsRememberWebAdminAccess(p: player):
    set {_name} to name of {_p}
    set {_uuid} to "%uuid of {_p}%"
    set {_has_editor} to false
    set {_is_op} to false
    if {_p} has permission "ultimateshop.editor":
        set {_has_editor} to true
    if {_p} is op:
        set {_is_op} to true
    set {mcwws.webAdmin.name::%{_uuid}%} to {_name}
    set {mcwws.webAdmin.op::%{_uuid}%} to {_is_op}
    set {mcwws.webAdmin.editor::%{_uuid}%} to {_has_editor}
    if {mcwws.webAdmin.uuids::*} does not contain {_uuid}:
        add {_uuid} to {mcwws.webAdmin.uuids::*}

function mcwwsFlushWebAdminAccessFile():
    set {_rel} to "plugins/Skript/scripts/web/data/admin_access.yml"
    set {_file} to new File({_rel})
    set {_parent} to {_file}.getParentFile()
    if {_parent}.exists() is false:
        {_parent}.mkdirs()
    if size of {mcwws.webAdmin.uuids::*} < 1:
        set {_text} to "players: {}%nl%"
    else:
        set {_text} to "players:%nl%"
        loop {mcwws.webAdmin.uuids::*}:
            set {_uuid} to loop-value
            set {_name} to {mcwws.webAdmin.name::%{_uuid}%}
            set {_op} to "false"
            if {mcwws.webAdmin.op::%{_uuid}%} is true:
                set {_op} to "true"
            set {_ed} to "false"
            if {mcwws.webAdmin.editor::%{_uuid}%} is true:
                set {_ed} to "true"
            set {_text} to "%{_text}%  ""%{_name}%"":%nl%    name: ""%{_name}%""%nl%    uuid: ""%{_uuid}%""%nl%    op: %{_op}%%nl%    ultimateshopEditor: %{_ed}%%nl%    permissions:%nl%      ""ultimateshop.editor"": %{_ed}%%nl%  ""%{_uuid}%"":%nl%    name: ""%{_name}%""%nl%    uuid: ""%{_uuid}%""%nl%    op: %{_op}%%nl%    ultimateshopEditor: %{_ed}%%nl%    permissions:%nl%      ""ultimateshop.editor"": %{_ed}%%nl%"
    set {_bytes} to {_text}.getBytes(StandardCharsets.UTF_8)
    Files.write({_file}.toPath(), {_bytes})

function mcwwsWriteWebAdminAccess(p: player):
    mcwwsRememberWebAdminAccess({_p})
    mcwwsFlushWebAdminAccessFile()

on load:
    loop all players:
        mcwwsRememberWebAdminAccess(loop-player)
    mcwwsFlushWebAdminAccessFile()

on join:
    wait 1 tick
    mcwwsWriteWebAdminAccess(player)
